# ─── REQUIRED ───────────────────────────────────────────────
# Supabase credentials (MCP server & API will fail-fast without these)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Turnkey MPC / Hardware TEE Enclave API Credentials (REQUIRED for non-custodial operations)
TURNKEY_API_PUBLIC_KEY="your_turnkey_api_public_key_here"
TURNKEY_API_PRIVATE_KEY="your_turnkey_api_private_key_here"
TURNKEY_ORGANIZATION_ID="your_turnkey_organization_id_here"

# Also expose to Vite frontend (client-side Supabase calls)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# ─── RECOMMENDED ────────────────────────────────────────────
# Moralis API Key for EVM token indexing, NFTs, and transaction history
VITE_MORALIS_API_KEY="your_moralis_api_key"

# 1inch API Key for EVM Swap & DEX aggregation
VITE_1INCH_API_KEY="your_1inch_api_key"

# ─── OPTIONAL ───────────────────────────────────────────────
# Custom EVM RPC URLs (defaults to public RPCs if not set)
ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"

# Groq AI inference key (for AI assistant features)
VITE_GROQ_API_KEY="your_groq_api_key"
