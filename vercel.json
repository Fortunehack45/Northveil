{
  "version": 2,
  "rewrites": [
    { "source": "/sse", "destination": "/api/index.ts" },
    { "source": "/mcp", "destination": "/api/index.ts" },
    { "source": "/openapi.json", "destination": "/api/index.ts" },
    { "source": "/health", "destination": "/api/index.ts" },
    { "source": "/authorize", "destination": "/api/index.ts" },
    { "source": "/token", "destination": "/api/index.ts" },
    { "source": "/register", "destination": "/api/index.ts" },
    { "source": "/ui/(.*)", "destination": "/api/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!assets|logo.png|favicon.png|favicon.ico).*)", "destination": "/index.html" }
  ]
}
